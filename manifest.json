{
  "manifest_version": 3,
  "name": "FluidExtension",
  "version": "0.1.3",
  "description": "Reply to Instagram DMs with a FluidTalk character, from a side panel.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://web.telegram.org/*",
    "https://web.whatsapp.com/*",
    "https://*.fluidvip.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "FluidExtension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content/media.js", "src/content/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content/instagram-mainworld.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.telegram.org/k/*"],
      "js": ["src/content/media.js", "src/content/telegram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/k/*"],
      "js": ["src/content/telegram-mainworld.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/media.js", "src/content/whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/whatsapp-mainworld.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
